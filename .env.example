# TrueForge Environment Configuration
# Copy this file to .env and configure your local or hosted providers
TRUEFORGE_SERVER_PORT=8790
TRUEFORGE_SERVER_HOST=localhost
OUTBOUND_URL_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'

# Primary Model Provider (Local Ollama or OpenAI-compatible)
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen2.5-coder:7b
OPENAI_API_KEY=ollama

# Secondary Fallback Model Provider (for Task C Resilience)
FALLBACK_MODEL_BASE_URL=http://localhost:11434/v1
FALLBACK_MODEL_NAME=qwen2.5-coder:7b
